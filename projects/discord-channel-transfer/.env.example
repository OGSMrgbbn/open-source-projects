# Nur lokal ausfüllen; niemals im Chat oder in Git teilen.
DISCORD_TOKEN=
# Beim Start automatisch veröffentlichte Git-Updates installieren.
AUTO_UPDATE=true
# Hintergrunddienst: online bleiben, Spiel mrgbbn.Studio, Textstatus wechseln.
PRESENCE_INTERVAL_SECONDS=60
PRESENCE_TEXTS='["mrgbbn.Studio","mrgbbn.Studio | Im Studio","mrgbbn.Studio | Kreativ am Werk"]'
# Optional: eigene Discord-Anwendung + hochgeladenes Rich-Presence-Asset.
# PRESENCE_APPLICATION_ID=DEINE_ANWENDUNGS_ID
# PRESENCE_IMAGE_ID=DEINE_ASSET_ID
